{
  "name": "just-ask-me",
  "version": "0.3.0",
  "private": true,
  "description": "Structured human-in-the-loop questions for OpenAI Codex CLI (and any MCP client) via MCP form elicitation, with a safe non-blocking fallback. Ships as a Codex plugin bundling a discuss-with-me skill.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "EliotOK",
    "url": "https://github.com/EliotOK"
  },
  "homepage": "https://github.com/EliotOK/JustAskMe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EliotOK/JustAskMe.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "codex",
    "elicitation",
    "human-in-the-loop",
    "ask-user-question"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "bin": {
    "just-ask-me": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:plugin": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=plugins/just-ask-me/server/index.mjs --log-level=warning",
    "clean": "node --input-type=module -e \"import {rmSync} from 'node:fs'; rmSync('dist',{recursive:true,force:true});\"",
    "start": "node ./dist/index.js",
    "dev": "tsx ./src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "test:smoke": "node scripts/smoke-stdio.mjs",
    "test:plugin": "node scripts/smoke-stdio.mjs plugins/just-ask-me/server/index.mjs",
    "verify": "npm run typecheck && npm run build && npm run build:plugin && npm test && npm run test:plugin && npm run test:installer && npm run test:browser",
    "prepublishOnly": "npm run build",
    "test:browser": "playwright test test/browser --workers=1",
    "test:installer": "python -m unittest discover -s test -p test_install.py"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
